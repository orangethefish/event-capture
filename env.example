# Core application URLs.
#
# The SPA and the API are served from ONE public origin: the frontend container proxies
# /api/v1, /login/oauth2 and /actuator to the API (frontend/nginx.conf.template). Both host
# and guest session cookies are SameSite=Lax, which browsers refuse to send cross-site, so a
# split api./app. topology would break authentication outright. Set both to the same origin.
APP_BASE_URL=https://app.example.com
APP_FRONTEND_ORIGIN=https://app.example.com
# Use `api` for the public HTTP role and `worker` for background job processing.
APP_RUNTIME_ROLE=api

# Browser authentication redirects and magic-link behavior.
# Paths must exist in the Angular router; APP_AUTH_FAILURE_PATH receives ?reason=<code>.
APP_AUTH_DEBUG_TOKEN_EXPOSURE=false
APP_AUTH_SUCCESS_PATH=/host/events
# Deprecated fallback, used only when APP_AUTH_SUCCESS_PATH is unset:
# APP_OAUTH_SUCCESS_PATH=/host/events
APP_AUTH_FAILURE_PATH=/host/login/callback
APP_AUTH_ALLOWED_RETURN_PATH_PREFIXES=/host,/host/

# Trust X-Forwarded-For only from these ingress/load-balancer networks. This MUST include the
# network the frontend/nginx container sits on, or ClientIpResolver attributes every request
# to the proxy and all per-IP abuse limits collapse into a single bucket.
APP_HTTP_TRUSTED_PROXY_CIDRS=10.20.0.0/16,2001:db8:ffff::/48

# A dedicated random 32-byte-or-longer base64 secret used only to HMAC abuse identifiers.
APP_ABUSE_KEY_SECRET=<base64-encoded-random-32-byte-secret>

# AES-256-GCM keyring for recoverable event share tokens. Load the real keyring from the
# deployment secret store and keep every key ID still referenced by ciphertext.
APP_SHARE_TOKEN_ACTIVE_KEY_ID=prod-v1
APP_SHARE_TOKEN_KEYRING=prod-v1=<base64-encoded-32-byte-key>
APP_SHARE_TOKEN_BACKFILL_ENABLED=false
APP_SHARE_TOKEN_RELEASE_B_PREFLIGHT_ENABLED=false
APP_SHARE_TOKEN_BACKFILL_BATCH_SIZE=100

# Database
APP_DATASOURCE_URL=jdbc:postgresql://postgres:5432/event_capture
APP_DATASOURCE_USERNAME=event_capture
APP_DATASOURCE_PASSWORD=change-me

# Infrastructure selection. Use `local` only for a single API process; worker and production
# runtimes require `redis`. APP_SESSION_STORE_TYPE remains a legacy fallback when this is unset.
APP_INFRASTRUCTURE_MODE=redis
APP_JOBS_OUTBOX_RELAY_DELAY=PT1S
APP_JOBS_RECLAIM_IDLE=PT30S
APP_JOBS_QUEUE_MONITOR_DELAY=PT10S

# Host and guest session settings
APP_SESSION_COOKIE_NAME=event_capture_session
APP_SESSION_NAMESPACE=eventcapture:sessions
APP_SESSION_TTL=P30D
APP_SESSION_SECURE_COOKIES=true

# Production SMTP delivery is required for magic links. These settings belong only on API nodes.
APP_SMTP_HOST=smtp.example.com
APP_SMTP_PORT=587
APP_SMTP_USERNAME=mailer@example.com
APP_SMTP_PASSWORD=change-me
APP_MAIL_FROM=Event Capture <mailer@example.com>
APP_SMTP_CONNECTION_TIMEOUT_MS=5000
APP_SMTP_READ_TIMEOUT_MS=5000
APP_SMTP_WRITE_TIMEOUT_MS=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Google OAuth is optional, but all three values must be supplied together when enabled.
# The callback must be an explicit HTTPS URL registered with Google.
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_REDIRECT_URI=
# Example enabled callback: https://app.example.com/login/oauth2/code/google
# (the public origin, because nginx proxies /login/oauth2 through to the API)

# Turnstile is required on production API nodes. Provider secrets never belong on workers.
APP_CHALLENGE_MODE=turnstile
APP_TURNSTILE_SITE_KEY=your-public-site-key
APP_TURNSTILE_SECRET=change-me
APP_TURNSTILE_EXPECTED_HOSTNAME=app.example.com
APP_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
APP_TURNSTILE_TIMEOUT=PT3S

# Redis is required for sessions, cross-instance SSE, jobs, and distributed abuse controls.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Media validation and processing. Production images install libvips and select it by default.
APP_MEDIA_PROCESSOR=libvips
APP_MEDIA_MAX_WIDTH=12000
APP_MEDIA_MAX_HEIGHT=12000
APP_MEDIA_MAX_PIXELS=40000000

# Object storage
APP_STORAGE_PROVIDER=r2
# Leave blank in production: backend-controlled reads enforce strict revocation.
APP_STORAGE_PUBLIC_BASE_URL=
APP_STORAGE_R2_BUCKET=event-capture-prod
APP_STORAGE_R2_ACCOUNT_ID=your-cloudflare-account-id
# Optional override. Leave blank to derive https://<account-id>.r2.cloudflarestorage.com
APP_STORAGE_R2_ENDPOINT=
APP_STORAGE_R2_ACCESS_KEY=your-r2-access-key
APP_STORAGE_R2_SECRET_KEY=your-r2-secret-key
# Maximum for upload and export presigns; export GETs are shortened by archive/retention lifetime.
APP_STORAGE_R2_PRESIGN_TTL=PT15M

# Optional local storage fallback for non-production environments
APP_STORAGE_LOCAL_ROOT=/var/tmp/event-capture-storage

# Optional opt-in live R2 smoke test toggle for backend integration verification.
EVENT_CAPTURE_LIVE_R2_SMOKE=false

# --- Frontend container -----------------------------------------------------
# host:port of the API service that nginx proxies /api/v1, /login/oauth2 and /actuator to.
BACKEND_UPSTREAM=backend-api:8080
# Host port the public origin is published on (compose only).
PUBLIC_PORT=8080

# --- Compose-only database bootstrap ----------------------------------------
POSTGRES_USER=event_capture
POSTGRES_PASSWORD=change-me
